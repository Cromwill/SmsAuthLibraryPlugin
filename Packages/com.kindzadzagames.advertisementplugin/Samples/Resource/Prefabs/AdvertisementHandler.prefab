  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\r\u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
    \u043E\u0442 \u0432\u0430\u0448\u0438\u0445 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043A
    \u043A\u043E\u043D\u0444\u0438\u0434\u0435\u043D\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043C\u044B \u043C\u043E\u0436\u0435\u043C \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C:
    \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u044B
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432, \u0440\u0435\u043A\u043B\u0430\u043C\u043D\u044B\u0435
    \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u044B,
    \u0434\u0430\u043D\u043D\u044B\u0435 \u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
    \u043C\u0435\u0441\u0442\u043E\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0438,
    \u0434\u0430\u043D\u043D\u044B\u0435 \u043E \u0432\u0430\u0448\u0438\u0445 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430\u0445
    \u0438 \u0434\u0435\u043C\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0434\u0430\u043D\u043D\u044B\u0435.\r"
  m_isRightToLeft: 0
